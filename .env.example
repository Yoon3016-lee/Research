# 로컬 개발용: 이 파일을 복사해 `.env.local`로 저장한 뒤 값을 채웁니다.
#
# Supabase (대시보드 → Project Settings → API)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co  ← 대시보드 Project Settings → API 의 Project URL (앞에 공백 없이)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 관리자 설문 목록 등 RLS 전체 조회용. 절대 클라이언트/브라우저에 노출하지 마세요.
# SUPABASE_SERVICE_ROLE_KEY=
#
# (선택) 원격 DB 마이그레이션 CLI용 — Settings → Database → Database password
# SUPABASE_DB_PASSWORD=
# (선택) URL에서 ref 추출 실패 시: SUPABASE_PROJECT_REF=프로젝트_ref
# 또는 전체 URI: DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres
#
# --- 공개 사이트 vs 관리자 전용 도메인 ---
# 공개 도메인 배포 시: 헤더·푸터의 "관리자" 링크를 숨기려면 false
# NEXT_PUBLIC_SHOW_PUBLIC_ADMIN_LINK=false
#
# 관리자 앱이 다른 URL이면(선택): 링크를 그 주소로 엽니다. 비우면 `/admin` (같은 오리진)
# NEXT_PUBLIC_ADMIN_SITE_URL=https://admin.example.com
#
# Vercel: 프로젝트(공개용 / 관리자용)마다 위 변수를 다르게 넣을 수 있습니다.
#
# --- AI 설문 생성 (서버 전용, /admin/surveys/ai-generate) ---
# 프로바이더: auto(기본) | openai | gemini
# auto — OPENAI_API_KEY가 있으면 OpenAI, 없으면 GEMINI_API_KEY 사용
# SURVEY_AI_PROVIDER=gemini
#
# Gemini (Google AI Studio 테스트용) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# (선택) GEMINI_API_KEY 대체: GOOGLE_API_KEY=
# (선택) 모델. 기본 gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
#
# OpenAI (운영용)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# (선택) 한 번에 생성할 설문안 개수 (1~3). 기본 3
# SURVEY_AI_PROPOSAL_COUNT=3
#
# --- AXI (설문 화면 가이드 AI) ---
# 설문 페이지 플로팅 아이콘 · Advisor Agent와 무관. SURVEY_AI_* / GEMINI·OPENAI 키와 동일 설정 사용
# 아이콘 이미지: 관리자 → 홈페이지 관리 → 기타 관리
# DB: supabase/migrations/20260409200000_site_settings_axi_icon.sql
#
# --- KSIC DB import (로컬 CLI) ---
# 마이그레이션: npm run db:migrate-ksic
# CSV 적재:     npm run db:import-ksic
# (SUPABASE_DB_PASSWORD 또는 DATABASE_URL 필요)
#
# --- KSIC 외부 검증 (공공데이터포털 · 무역보험공사 업종등급목록) ---
# https://www.data.go.kr/data/15144476/openapi.do
# DATA_GO_KR_SERVICE_KEY=발급받은_인증키
# (선택) DATA_GO_KR_SERVICE_KEY 대체: PUBLIC_DATA_PORTAL_SERVICE_KEY=
# 마이그레이션: npm run db:migrate-ksic-external
# API 동기화:   npm run db:sync-ksic-external
# diff 확인:    npm run db:check-ksic-sync
# 단일 코드:    npm run db:check-ksic-sync -- 01500
# DB 연결: DATABASE_URL / SUPABASE_DB_PASSWORD 또는
#           NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
